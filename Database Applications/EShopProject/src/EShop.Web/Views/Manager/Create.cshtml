@model EShop.Application.DTO.ProductDto

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4" style="max-width: 600px;">
    <h3>Add New Product</h3>
    <hr />
    
    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create">
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Product Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Gaming Laptop" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Sku" class="form-label">SKU (Code)</label>
                    <input asp-for="Sku" class="form-control" placeholder="e.g. LAP-001" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price (PLN)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tags (comma separated)</label>
                    <input type="text" name="tagsInput" class="form-control" placeholder="e.g. Promo, Summer, Hit" />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Create Product</button>
                </div>

            </form>
        </div>
    </div>
</div>